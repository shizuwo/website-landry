{
  "name": "Admin Landry",
  "short_name": "Admin",
  "start_url": "/admin",
  "scope": "/admin",
  "display": "standalone",
  "theme_color": "#B3212E",
  "background_color": "#F6F3EE",
  "icons": [
    {
      "src": "/icone-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icone-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/admin/partage",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titre",
      "text": "texte",
      "url": "lien",
      "files": [
        {
          "name": "fichiers",
          "accept": [
            "*/*"
          ]
        }
      ]
    }
  }
}