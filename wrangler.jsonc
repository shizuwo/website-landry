{
  // Remplace le Worker actuel "website-landry" (ton domaine landrypf.com reste branché dessus)
  "name": "website-landry",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/", "/index.html", "/api/*", "/go/*", "/l/*", "/f/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "landry-db",
      "database_id": "cdbbec9c-9da5-4c43-ab41-74bd30807654"
    }
  ],
  "r2_buckets": [
    { "binding": "FICHIERS", "bucket_name": "landry-fichiers" }
  ],
  "observability": { "enabled": true }
  // Secrets à ajouter dans le tableau de bord (Settings → Variables and Secrets) :
  //   ADMIN_KEY : ton mot de passe pour /admin
  //   SEL       : une phrase au hasard (anonymise les visiteurs)
  //   NTFY_TOPIC: (facultatif) le nom secret de ton canal ntfy, pour les notifications
}
